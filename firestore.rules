rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Hanya user yang sudah sign-in (termasuk anonymous) yang boleh baca/tulis.
    // Ini baseline minimum -- cukup untuk mencegah orang asing di internet
    // membaca/mengubah data lewat URL Firestore langsung, TAPI siapa pun yang
    // bisa membuka app ini (link publik) tetap bisa baca/tulis semua data,
    // karena anonymous sign-in otomatis dan tidak membedakan SBA satu dengan lainnya.
    //
    // Kalau nanti butuh: SBA A tidak boleh ubah data toko milik SBA B,
    // atau perlu login dengan akun berbeda per SBA/area, aturan ini perlu
    // diperketat (misal pakai Firebase Auth email/password atau custom claims
    // per area) -- beri tahu saya kalau sampai ke tahap itu.

    match /entries/{entryId} {
      allow read, write: if request.auth != null;
    }

    match /distributorStock/{area} {
      allow read, write: if request.auth != null;
    }

    match /priceEntries/{entryId} {
      allow read, write: if request.auth != null;
    }

    match /competitors/{docId} {
      allow read, write: if request.auth != null;
    }

    match /promoSku/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
